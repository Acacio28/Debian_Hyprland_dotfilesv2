diff --git a/hyprmod/core/config.py b/hyprmod/core/config.py
index 21aa8dd..319184e 100644
--- a/hyprmod/core/config.py
+++ b/hyprmod/core/config.py
@@ -1,6 +1,7 @@
 """Read/write hyprmod's managed config file (path is user-configurable via ``set_gui_conf``)."""
 
 import logging
+import re
 from contextlib import contextmanager
 from dataclasses import dataclass
 from pathlib import Path
@@ -307,3 +308,181 @@ def build_content(values: dict[str, str], sections: ConfigSections) -> str:
 def write_all(values: dict[str, str], sections: ConfigSections) -> None:
     """Write all values and special lines to the config file."""
     atomic_write(gui_conf(), build_content(values, sections))
+
+
+# -- Lua config writer -------------------------------------------------------
+
+LUA_CONF = Path.home() / ".config" / "hypr" / "hyprland-gui.lua"
+
+
+def _quote_lua(s: str) -> str:
+    """Wrap string in double quotes with proper escaping for Lua."""
+    escaped = s.replace("\\", "\\\\").replace('"', '\\"')
+    return f'"{escaped}"'
+
+
+def _to_lua_value(val: str) -> str:
+    """Convert a config string value to a Lua literal."""
+    stripped = val.strip()
+    if stripped in ("true", "false"):
+        return stripped
+    # Strip trailing deg gradient suffix
+    cleaned = re.sub(r"\s*\d+deg\s*$", "", stripped).strip()
+    # Try numeric
+    try:
+        float(cleaned)
+        return cleaned
+    except ValueError:
+        pass
+    return _quote_lua(cleaned)
+
+
+def _key_to_lua_path(key: str) -> list[str]:
+    """Split 'general:col.active_border' into ['general', 'col', 'active_border']."""
+    parts = []
+    for segment in key.replace(".", ":").split(":"):
+        segment = segment.strip()
+        if segment:
+            parts.append(segment)
+    return parts
+
+
+def _build_lua_content(values: dict[str, str], sections: ConfigSections) -> str:
+    """Build hyprland-gui.lua content from GUI state."""
+    lines: list[str] = []
+    lines.append("-- " + "/" + "*" + " " + "-" * 4 + " https://github.com/Acacio28 " + "-" * 4 + " " + "*" + "/")
+    lines.append("-- Generated by HyprMod GUI -- do not edit manually")
+    lines.append("")
+
+    # env
+    if sections.env:
+        for env_line in sections.env:
+            m = re.match(r"(?:env\s*=\s*)?([^,=]+?)\s*[=,]\s*(.+)", env_line)
+            if m:
+                key = _quote_lua(m.group(1).strip())
+                val = _quote_lua(m.group(2).strip())
+                lines.append(f"hl.env({key}, {val})")
+        lines.append("")
+
+    # hl.config with values
+    tree: dict = {}
+    for key, val in values.items():
+        if not val or not key:
+            continue
+        parts = _key_to_lua_path(key)
+        if not parts:
+            continue
+        node = tree
+        for part in parts[:-1]:
+            node = node.setdefault(part, {})
+        node[parts[-1]] = val
+
+    if tree:
+        lines.append("hl.config({")
+        _emit_config(lines, tree, 1)
+        lines.append("})")
+        lines.append("")
+
+    # beziers
+    if sections.beziers:
+        for bezier_line in sections.beziers:
+            m = re.match(
+                r"(?:bezier\s*=\s*)?(.+?)\s*,\s*([\d\.\-]+)\s*,\s*([\d\.\-]+)\s*,\s*([\d\.\-]+)\s*,\s*([\d\.\-]+)",
+                bezier_line,
+            )
+            if m:
+                name = _quote_lua(m.group(1).strip())
+                pts = ",".join(f"{{{m.group(i)},{m.group(i+1)}}}" for i in (2, 4))
+                lines.append(f'hl.curve({name}, {{ type = "bezier", points = {{{pts}}} }})')
+        lines.append("")
+
+    # animations
+    if sections.animations:
+        for anim_line in sections.animations:
+            m = re.match(
+                r"(?:animation\s*=\s*)?\s*([^,]+)\s*,\s*(\d+)\s*,\s*([^,]+?)\s*,\s*([^,]+?)\s*,\s*(.+)",
+                anim_line,
+            )
+            if m:
+                name, enabled_s, speed, bezier, style = (m.group(i).strip() for i in range(1, 6))
+                enabled = "true" if enabled_s == "1" else "false"
+                lines.append(
+                    f"hl.animation({{ leaf = {_quote_lua(name)}, enabled = {enabled},"
+                    f" speed = {speed}, bezier = {_quote_lua(bezier)},"
+                    f" style = {_quote_lua(style)} }})"
+                )
+        lines.append("")
+
+    return "\n".join(lines) + "\n"
+
+
+def _emit_config(lines: list[str], node: dict, indent: int) -> None:
+    """Recursively emit Lua table body for hl.config()."""
+    pad = "    " * indent
+    for key, val in node.items():
+        if isinstance(val, dict):
+            lines.append(f"{pad}{key} = {{")
+            _emit_config(lines, val, indent + 1)
+            lines.append(f"{pad}}},")
+        else:
+            lines.append(f"{pad}{key} = {_to_lua_value(val)},")
+
+
+def write_lua(values: dict[str, str], sections: ConfigSections) -> None:
+    """Replace the hl.config() block in hyprland-gui.lua with GUI state, then reload.
+
+    Only the ``hl.config({...})`` block is replaced — everything else in the
+    file (curves, animations not managed by the GUI, etc.) is preserved.
+    """
+    import subprocess
+
+    new_block = _build_lua_config_block(values)
+
+    if LUA_CONF.exists():
+        old = LUA_CONF.read_text()
+        # Replace the hl.config({...}) block
+        start = old.find("hl.config({")
+        if start >= 0:
+            depth = 1
+            pos = start + len("hl.config({")
+            while depth > 0 and pos < len(old):
+                ch = old[pos]
+                if ch == "{":
+                    depth += 1
+                elif ch == "}":
+                    depth -= 1
+                pos += 1
+            end = old.find(")", pos - 1) + 1
+            if end > start:
+                updated = old[:start] + new_block + old[end:]
+                LUA_CONF.write_text(updated)
+                subprocess.run(["hyprctl", "reload"], capture_output=True)
+                return
+
+    # No existing file or no hl.config block found — write full content
+    full = _build_lua_content(values, sections)
+    LUA_CONF.write_text(full)
+    subprocess.run(["hyprctl", "reload"], capture_output=True)
+
+
+def _build_lua_config_block(values: dict[str, str]) -> str:
+    """Build just the hl.config({...}) block string (no leading/trailing cruft)."""
+    tree: dict = {}
+    for key, val in values.items():
+        if not val or not key:
+            continue
+        parts = _key_to_lua_path(key)
+        if not parts:
+            continue
+        node = tree
+        for part in parts[:-1]:
+            node = node.setdefault(part, {})
+        node[parts[-1]] = val
+
+    if not tree:
+        return "hl.config({})"
+
+    lines = ["hl.config({"]
+    _emit_config(lines, tree, 1)
+    lines.append("})")
+    return "\n".join(lines) + "\n"
